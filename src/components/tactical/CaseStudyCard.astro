---
import TacticalContainer from './TacticalContainer.astro';

interface Props {
  title: string;
  category: string;
  challenge: string;
  solution: string;
}

const { title, category, challenge, solution } = Astro.props;
---

<TacticalContainer class="bg-black border-zinc-800 flex flex-col gap-6 p-6">
  <div>
    <span class="font-mono text-xs text-accent tracking-[0.2em] mb-2 block">{category.toUpperCase()}</span>
    <h3 class="font-display text-2xl text-white font-bold">{title}</h3>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
    <div class="space-y-2">
      <span class="font-mono text-xs text-zinc-500">DESAFIO</span>
      <p class="text-sm text-zinc-300 leading-relaxed">{challenge}</p>
    </div>
    <div class="space-y-2">
      <span class="font-mono text-xs text-zinc-500">DIREÇÃO & NARRATIVA</span>
      <p class="text-sm text-zinc-300 leading-relaxed">{solution}</p>
    </div>
  </div>
</TacticalContainer>
